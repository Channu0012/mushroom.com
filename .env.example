# =============================================================================
# MUSHROOM MARKETPLACE — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env (never commit .env to git)
# All variables marked [REQUIRED] must be set before the app will start.
# Variables marked [OPTIONAL] have defaults or are for future use.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/mushroom_marketplace?schema=public"

# [OPTIONAL] Use a separate test database for integration tests
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/mushroom_marketplace_test?schema=public"

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# [REQUIRED] Redis connection for BullMQ queues and rate limiting
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# [REQUIRED] Secret for access tokens — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_256_BIT_SECRET"
# [REQUIRED] Access token expiry (NestJS format)
JWT_ACCESS_EXPIRES_IN="15m"

# [REQUIRED] Secret for refresh tokens — different from access secret
JWT_REFRESH_SECRET="CHANGE_THIS_TO_A_DIFFERENT_SECURE_RANDOM_256_BIT_SECRET"
# [REQUIRED] Refresh token expiry
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# [REQUIRED] Environment: development | staging | production
NODE_ENV="development"

# [REQUIRED] API port
API_PORT=3001

# [REQUIRED] API base URL (used in emails, webhooks)
API_URL="http://localhost:3001"

# [REQUIRED] Frontend URL (used in emails, CORS)
WEB_URL="http://localhost:3000"

# [OPTIONAL] Log level: error | warn | log | debug | verbose
LOG_LEVEL="debug"

# -----------------------------------------------------------------------------
# RAZORPAY PAYMENTS (India)
# -----------------------------------------------------------------------------
# [REQUIRED for payments] Get test keys from https://dashboard.razorpay.com
# Test Key ID starts with rzp_test_
RAZORPAY_KEY_ID="rzp_test_REPLACE_WITH_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_YOUR_KEY_SECRET"
# [REQUIRED for webhooks] Set this in Razorpay dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_YOUR_WEBHOOK_SECRET"

# -----------------------------------------------------------------------------
# EMAIL (Resend)
# -----------------------------------------------------------------------------
# [REQUIRED for emails] Get API key from https://resend.com
RESEND_API_KEY="re_REPLACE_WITH_YOUR_API_KEY"
# [REQUIRED for emails] Must be a verified domain in Resend
EMAIL_FROM="Mushroom Marketplace <noreply@yourdomain.com>"
# [OPTIONAL] Support email shown to users
EMAIL_SUPPORT="support@yourdomain.com"

# -----------------------------------------------------------------------------
# CLOUDINARY (File Storage)
# -----------------------------------------------------------------------------
# [REQUIRED for uploads] Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="REPLACE_WITH_CLOUD_NAME"
CLOUDINARY_API_KEY="REPLACE_WITH_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_WITH_API_SECRET"
# [OPTIONAL] Prefix for all uploaded files
CLOUDINARY_FOLDER="mushroom-marketplace"

# -----------------------------------------------------------------------------
# PLATFORM SETTINGS (configurable via admin, these are initial defaults)
# -----------------------------------------------------------------------------
# [OPTIONAL] Default platform commission rate (3% = 0.03)
# This seeds the platform_settings table. Change via admin panel thereafter.
INITIAL_COMMISSION_RATE="0.03"

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# [OPTIONAL] Comma-separated additional allowed CORS origins
# WEB_URL is always allowed; add staging/other domains here
ADDITIONAL_CORS_ORIGINS=""

# [OPTIONAL] Max upload file size in bytes (default 5MB for images)
MAX_IMAGE_SIZE_BYTES="5242880"
# [OPTIONAL] Max document upload size in bytes (default 10MB)
MAX_DOCUMENT_SIZE_BYTES="10485760"

# -----------------------------------------------------------------------------
# OPTIONAL / FUTURE INTEGRATIONS
# -----------------------------------------------------------------------------
# SMS (MSG91 for India) — stub, not active in MVP
# MSG91_API_KEY=""
# MSG91_SENDER_ID=""

# Google Maps (for geocoding) — stub
# GOOGLE_MAPS_API_KEY=""

# Sentry (error monitoring)
# SENTRY_DSN=""

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# 1. NEVER commit .env to git
# 2. Set all [REQUIRED] variables in your deployment platform
# 3. Use secrets management (Railway, Vercel, AWS Secrets Manager)
# 4. Rotate JWT secrets if compromised; all existing sessions will be invalidated
# 5. Razorpay: use rzp_live_ keys only in production
# 6. Resend: verify your sending domain before production launch
# 7. Cloudinary: enable unsigned upload restrictions in production
# =============================================================================
